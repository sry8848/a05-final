<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.a05.aiinterview.interview.mapper.QuestionConsultMessageMapper">

    <resultMap id="QuestionConsultMessageResultMap" type="com.a05.aiinterview.interview.entity.QuestionConsultMessage">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="session_id" property="sessionId"/>
        <result column="question_id" property="questionId"/>
        <result column="role" property="role"/>
        <result column="status" property="status"/>
        <result column="content" property="content"/>
        <result column="reply_to_message_id" property="replyToMessageId"/>
        <result column="error_message" property="errorMessage"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="selectConversation" resultMap="QuestionConsultMessageResultMap">
        SELECT *
        FROM question_consult_messages
        WHERE user_id = #{userId}
          AND session_id = #{sessionId}
          AND question_id = #{questionId}
        ORDER BY created_at ASC, id ASC
    </select>

    <select id="selectLatestGenerating" resultMap="QuestionConsultMessageResultMap">
        SELECT *
        FROM question_consult_messages
        WHERE user_id = #{userId}
          AND session_id = #{sessionId}
          AND question_id = #{questionId}
          AND role = 'assistant'
          AND status = 'generating'
        ORDER BY created_at DESC, id DESC
        LIMIT 1
    </select>
</mapper>
