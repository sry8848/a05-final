<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.a05.aiinterview.interview.mapper.InterviewAttemptMapper">

    <resultMap id="InterviewAttemptResultMap" type="com.a05.aiinterview.interview.entity.InterviewAttempt">
        <id column="id" property="id"/>
        <result column="session_id" property="sessionId"/>
        <result column="question_id" property="questionId"/>
        <result column="attempt_id" property="attemptId"/>
        <result column="answer_text" property="answerText"/>
        <result column="is_final" property="isFinal"/>
        <result column="evaluation_json"
                property="evaluationJson"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="detail_evaluation_status" property="detailEvaluationStatus"/>
        <result column="detail_evaluation_json"
                property="detailEvaluationJson"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="selectByAttemptId" resultMap="InterviewAttemptResultMap">
        SELECT *
        FROM interview_attempts
        WHERE attempt_id = #{attemptId}
        LIMIT 1
    </select>

    <select id="selectBySessionId" resultMap="InterviewAttemptResultMap">
        SELECT *
        FROM interview_attempts
        WHERE session_id = #{sessionId}
        ORDER BY question_id ASC, created_at DESC, id DESC
    </select>

    <select id="selectLatestFinalAttempt" resultMap="InterviewAttemptResultMap">
        SELECT *
        FROM interview_attempts
        WHERE session_id = #{sessionId}
          AND question_id = #{questionId}
          AND is_final = 1
        ORDER BY created_at DESC, id DESC
        LIMIT 1
    </select>
</mapper>
