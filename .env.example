# 根目录 .env 的作用域
# 1. docker compose 会自动读取
# 2. frontend/vite 会自动读取（已配置 envDir=..）
# 3. backend 本地 mvn spring-boot:run 不会自动读取，必须先导入当前终端或在 IDE 运行配置里手动设置

# 第一次部署建议：
# 先把 AI、SMTP、语音这几组必填项补完整
# 其他值如果你不确定，先保持默认

# Docker Compose 基础服务
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# 前端
# 留空时，前端走本地 Vite 代理 -> http://localhost:8080/api/v1
VITE_API_BASE_URL=

# SMTP 邮件发送
# 注意：backend 本地 mvn spring-boot:run 不会自动读取本文件，需先导入当前终端或在 IDE 运行配置里手动设置
# SMTP_PASSWORD 很多时候填的不是邮箱登录密码，而是 SMTP 授权码 / 应用专用密码
# SMTP_FROM 通常和 SMTP_USERNAME 一样，都是发件邮箱地址
# 常见组合：
# 1. 587 + STARTTLS -> SMTP_STARTTLS_ENABLE=true, SMTP_SSL_ENABLE=false
# 2. 465 + SSL      -> SMTP_STARTTLS_ENABLE=false, SMTP_SSL_ENABLE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_SSL_ENABLE=false
SMTP_STARTUP_CHECK_ENABLED=true

# 后端推荐主流程：local profile + 百炼 + 语音 + Qdrant
# 当前 local 流程里，AI、ASR、TTS 默认共用同一个 AI_BAILIAN_API_KEY
AI_BAILIAN_API_KEY=
RAG_ENABLED=true
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_COLLECTION=interview_knowledge

# 第一次只想验证 Qdrant 链路时，可临时改成 true
# 成功启动一次后建议改回 false，避免重复写入样本
RAG_INIT_SAMPLE=false

# 语音能力
ASR_ENABLED=true
ASR_ENDPOINT=wss://dashscope.aliyuncs.com/api-ws/v1/inference
ASR_MODEL=paraformer-realtime-v2

TTS_ENABLED=true
TTS_ENDPOINT=wss://dashscope.aliyuncs.com/api-ws/v1/inference
TTS_MODEL=cosyvoice-v3-flash
TTS_VOICE=longanyang
